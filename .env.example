# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fairshare"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fairshare"

# Auth.js (generate a secret with: npx auth secret)
AUTH_SECRET=""
# Public URL of the app; also used to build invite and password-reset links
AUTH_URL="http://localhost:3000"

# Optional: Google sign-in
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Passkeys (WebAuthn). RP_ID is the bare domain, ORIGIN the full origin.
AUTH_WEBAUTHN_RP_ID="localhost"
AUTH_WEBAUTHN_RP_NAME="FairShare"
AUTH_WEBAUTHN_RP_ORIGIN="http://localhost:3000"

# Optional: send invite and password-reset emails through Resend.
# Without these, emails are printed to the server log and the UI shows
# the invite link so it can be shared by hand.
RESEND_API_KEY=""
EMAIL_FROM="FairShare <noreply@example.com>"

# Receipt photos are stored here (outside public/; served only to group members).
# Default ./uploads. Production: a persistent volume, e.g. ~/docker-apps/fairshare-prod/uploads
UPLOAD_DIR=./uploads

# Background jobs: POST /api/cron/run with "Authorization: Bearer $CRON_SECRET"
# (at least 16 characters; generate with: openssl rand -hex 32). Without it the
# endpoint always answers 401. ops/fairshare-cron.timer calls it every 5 min.
CRON_SECRET=
# Only for testing in production: let the cron body {"now": "..."} fake the clock
# CRON_ALLOW_FAKE_NOW=1

# Optional: WhatsApp notifications through a WAHA server (https://waha.devlike.pro).
# Without WAHA_URL and WAHA_API_KEY, WhatsApp is shown as unavailable and nothing is sent.
WAHA_URL=
WAHA_API_KEY=
WAHA_SESSION=default
