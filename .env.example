# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fairshare"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fairshare"

# Auth.js (generate a secret with: npx auth secret)
AUTH_SECRET=""
# Public URL of the app; also used to build invite and password-reset links
AUTH_URL="http://localhost:3000"

# Optional: Google sign-in
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Passkeys (WebAuthn). RP_ID is the bare domain, ORIGIN the full origin.
AUTH_WEBAUTHN_RP_ID="localhost"
AUTH_WEBAUTHN_RP_NAME="FairShare"
AUTH_WEBAUTHN_RP_ORIGIN="http://localhost:3000"

# Optional: send invite and password-reset emails through Resend.
# Without these, emails are printed to the server log and the UI shows
# the invite link so it can be shared by hand.
RESEND_API_KEY=""
EMAIL_FROM="FairShare <noreply@example.com>"
