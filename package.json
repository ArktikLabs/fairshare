    "@radix-ui/react-popover": "^1.2.0",
    "@simplewebauthn/browser": "^9.0.1",
    "@simplewebauthn/server": "^9.0.2",
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "next": "15.5.2",
    "next-auth": "5.0.0-beta.29",
    "prisma": "^6.14.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "0.34.3",
    "tailwind-merge": "^3.7.0",
